{
  "name": "sharecoin-simple-wallet",
  "version": "0.1.0",
  "description": "Simple wallet + one-click miner companion app for casual Sharecoin users",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . sharecoin --platform=win32 --arch=x64 --out=dist --overwrite --extra-resource=resources/bin --extra-resource=THIRD_PARTY_LICENSES.md --ignore=\"^/resources($|/)\" --ignore=\"^/dist($|/)\" --ignore=\"^/node_modules($|/)\" --ignore=\"^/NOTES\\.md$\" --ignore=\"^/\\.gitignore$\" --ignore=\"^/THIRD_PARTY_LICENSES\\.md$\"",
    "package:portable": "electron-builder --win --publish=never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.sharecoin.simplewallet",
    "productName": "sharecoin",
    "directories": {
      "output": "dist-portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/bin", "to": "bin" },
      { "from": "THIRD_PARTY_LICENSES.md", "to": "THIRD_PARTY_LICENSES.md" }
    ],
    "win": {
      "target": ["portable"],
      "signAndEditExecutable": false,
      "artifactName": "sharecoin.exe"
    }
  }
}
